# ---------------------------------------------------------
# SMS Web Viewer - Environment Configuration Example
# ---------------------------------------------------------

# Server Configuration
APP_HOST="0.0.0.0"
APP_PORT=8000

# Database Connection (SQLite embedded default)
# For PostgreSQL: postgresql+asyncpg://user:pass@host:5432/smsviewer
DATABASE_URL="sqlite+aiosqlite:////data/smsviewer.db"

# ---------------------------------------------------------
# Google Drive Sync Configuration (Required for Syncing)
# ---------------------------------------------------------
# Obtain these from the Google Cloud Console (OAuth Client ID)
GCP_CLIENT_ID="your_client_id_here.apps.googleusercontent.com"
GCP_CLIENT_SECRET="your_client_secret_here"
# Must exactly match the Authorized Redirect URI in Google Cloud
OAUTH_REDIRECT_URI="http://localhost:8000/api/auth/callback"

# Optional: Default sync schedule (Cron format). Default is 2 AM daily.
SYNC_SCHEDULE="0 2 * * *"
# Optional: Default country code for phone number normalization (E.164)
DEFAULT_COUNTRY_CODE="US"

# ---------------------------------------------------------
# Authentication & Multi-Tenancy
# ---------------------------------------------------------
# Options: NONE, BASIC, OIDC
AUTH_MODE="NONE"
# Used for JWT signing in BASIC and OIDC modes
SECRET_KEY="change-me-in-production-long-random-string"

# OpenID Connect (OIDC) Settings (Only used if AUTH_MODE="OIDC")
# OIDC_ISSUER_URL="https://your-auth-provider.com/realms/master"
# OIDC_CLIENT_ID="your_oidc_client_id"
# OIDC_CLIENT_SECRET="your_oidc_client_secret"
