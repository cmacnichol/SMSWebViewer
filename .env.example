# Database (SQLite default, or use PostgreSQL connection string)
DATABASE_URL=sqlite+aiosqlite:////data/smsviewer.db
# DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/smsviewer

# Server Configuration
APP_HOST=0.0.0.0
APP_PORT=8000

# Google OAuth2 Credentials (from Google Cloud Console Setup)
GCP_CLIENT_ID="your_client_id_here.apps.googleusercontent.com"
GCP_CLIENT_SECRET="your_client_secret_here"

# The redirect URI must match exactly what you put in Google Cloud Console
OAUTH_REDIRECT_URI="http://localhost:8000/api/auth/callback"

# Optional: Set the default sync schedule (cron format). Default is 2 AM daily.
SYNC_SCHEDULE="0 2 * * *"

# Optional: Default country code for phone number normalization (E.164)
DEFAULT_COUNTRY_CODE="US"
